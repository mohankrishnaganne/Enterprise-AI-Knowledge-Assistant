# =============================================================================
# Copy to `.env` and fill in the two API keys. Everything else has a sane default.
#     cp .env.example .env
#
# IMPORTANT: comments must be on their own lines, never trailing a value.
# python-dotenv (used when running locally) strips inline `# ...` comments, but
# Docker's `--env-file` and compose's `env_file` parser do NOT -- they pass the
# comment through as part of the value. `RETRIEVAL_TOP_K=5  # tuned` then arrives
# as the string "5  # tuned" and fails validation inside the container while
# working perfectly outside it.
# =============================================================================

# ---- LLM: Groq (free tier -> https://console.groq.com/keys) ------------------
# Groq retires models periodically. `python -m src.agent.graph --check` verifies
# these ids are still served and lists the alternatives if they are not.
# NOTE: the Llama 3 models most RAG tutorials use are no longer served by Groq.
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL_STRONG=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ---- Vector DB: Pinecone (free tier -> https://app.pinecone.io) --------------
# PINECONE_REGION: us-east-1 is the only region on the free serverless tier.
# PINECONE_BASELINE_NAMESPACE holds the naive chunks used only by `make bench`.
PINECONE_API_KEY=pcsk_replace_me
PINECONE_INDEX_NAME=enterprise-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=v1
PINECONE_BASELINE_NAMESPACE=baseline

# ---- Embeddings: local HuggingFace, no key needed ----------------------------
# Set EMBEDDING_DEVICE=cuda if you have a GPU. Changing EMBEDDING_MODEL usually
# changes EMBEDDING_DIM too, and a Pinecone index's dimension is immutable --
# you must delete and recreate the index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ---- Chunking ----------------------------------------------------------------
# The optimized configuration. The benchmark's naive baseline is hardcoded in
# src/ingestion/chunker.py so it cannot be tuned after the fact.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ---------------------------------------------------------------
# These three were tuned on the benchmark's dev split; see
# reports/retrieval_benchmark.md.
#
# RETRIEVAL_TOP_K=5      the benchmark measures at k=5, so production matches it.
# RETRIEVAL_MMR_LAMBDA   1.0 = pure relevance, 0.0 = pure diversity. MMR measurably
#                        HURT on this corpus (only ~1.6 chunks per question contain
#                        the answer, so there is no breadth to recover). Lower it if
#                        your corpus has multi-faceted answers.
# RETRIEVAL_SCORE_THRESHOLD  where nearly all the measured gain comes from. Corpus
#                        specific: the original 0.35 was a no-op because every bge
#                        cosine score sat above it.
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_MMR_LAMBDA=1.0
RETRIEVAL_SCORE_THRESHOLD=0.62

# ---- Agent behaviour ---------------------------------------------------------
# MAX_QUERY_REWRITES is the self-correction loop guard; MAX_SUBQUERIES caps
# task decomposition.
MAX_QUERY_REWRITES=2
MAX_SUBQUERIES=3

# ---- Serving -----------------------------------------------------------------
# API_BASE_URL is what Streamlit calls. Use http://api:8000 under docker compose,
# http://127.0.0.1:8000 inside the single-container image.
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
